# Keep Stripe Checkout disabled until the product, webhook, and end-to-end
# acceptance checks pass for the selected Stripe mode.
HONE_STRIPE_CHECKOUT_ENABLED=false

# Stripe billing (test mode first). Standard `sk_*` and restricted `rk_*` keys
# are accepted when their mode matches. Prefer a least-privilege restricted key
# in production. Never commit real secret values.
# Use test-mode prod_/price_ IDs here during development; do not reuse live IDs.
# HONE_STRIPE_WEBHOOK_SECRET is deployment-specific: local `stripe listen`, a
# registered test endpoint, and a registered live endpoint each have a
# different signing secret. Never copy the CLI secret into a deployed runtime.
HONE_STRIPE_MODE=test
HONE_STRIPE_SECRET_KEY=
HONE_STRIPE_WEBHOOK_SECRET=
HONE_STRIPE_PRODUCT_ID=
HONE_STRIPE_PRICE_ID=
HONE_STRIPE_PUBLIC_BASE_URL=https://hone-claw.com/

# Failed renewal keeps previously paid access for this many days (1-30).
HONE_BILLING_GRACE_DAYS=7

# Cloudflare Email Sending
# All three values are required together; partial configuration fails startup.
HONE_CLOUDFLARE_ACCOUNT_ID=
HONE_CLOUDFLARE_EMAIL_API_TOKEN=
HONE_EMAIL_FROM=verify@hone-claw.com

# Aliyun public SMS verification
# Required together on every backend that serves domestic phone login.
# Keep real values only in an ignored local env or the host's protected
# systemd environment file; never commit credentials here.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
